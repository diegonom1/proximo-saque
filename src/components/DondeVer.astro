---
import IconoSvg from './IconoSvg.astro';
import type { Partido } from '../lib/datos';
import { dondeVer } from '../lib/datos';
import { iconoPlataforma } from '../lib/iconos';

interface Props {
  partido: Partido;
}

const plataformas = dondeVer(Astro.props.partido);
---

<div class="donde">
  <p class="dato">Dónde verlo</p>
  {
    plataformas.length > 0 ? (
      <ul>
        {plataformas.map((x) => (
          <li>
            <a href={x.url} target="_blank" rel="noopener" aria-label={x.nombre} title={x.nombre}>
              <IconoSvg icono={iconoPlataforma(x)} />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="donde__nota">Por confirmar</p>
    )
  }
</div>

<style>
  .donde__nota {
    color: var(--gris);
    font-size: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  a {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--linea);
    border-radius: 50%;
  }
</style>
