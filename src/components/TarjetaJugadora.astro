---
import { Picture } from 'astro:assets';
import type { Jugadora } from '../lib/datos';
import { clubes } from '../lib/datos';
import { anchosPara, fotosJugadora } from '../lib/fotos';
import { apellido } from '../lib/perfil';
import { iniciales } from '../lib/tiempo';
import { POR_CONFIRMAR, ruta } from '../lib/presentacion';
import { modoDeFoto } from '../lib/tratamiento';

interface Props {
  jugadora: Jugadora;
}

const { jugadora: j } = Astro.props;
const { tarjeta, fondo, recorte } = fotosJugadora(j.slug);
const foto = tarjeta ?? fondo; // sin retrato, un recorte de la foto de fondo
const conRecorte = modoDeFoto(j.fotos.tratamiento, { fondo, recorte }) === 'recorte' && recorte;
const club = j.clubId ? clubes[j.clubId]?.nombre : null;
const texto = apellido(j.nombre);
---

<a class="tarjeta" href={ruta(`jugadoras/${j.slug}`)} data-tarjeta data-color={j.fotos.color ?? 'rojo'}>
  <div class="tarjeta__foto" data-orilla={j.fotos.orilla ?? undefined}>
    {
      conRecorte ? (
        <>
          <span class="relleno tarjeta__apellido" aria-hidden="true" data-tarjeta-apellido>
            {texto}
            <span class="relleno__capa"><span class="relleno__interior">{texto}</span></span>
          </span>
          <Picture
            class="tarjeta__recorte"
            src={conRecorte}
            alt=""
            formats={['webp']}
            fallbackFormat="webp"
            widths={anchosPara(conRecorte, [320, 480, 640])}
            sizes="(min-width: 1024px) 340px, 72vw"
            data-foto-vt={j.slug}
          />
          {j.numero !== null && <span class="tarjeta__marcador" data-contar={j.numero} data-contar-manual aria-hidden="true">{j.numero}</span>}
        </>
      ) : foto ? (
        <Picture
          class="tarjeta__retrato"
          src={foto}
          alt=""
          formats={['avif', 'webp']}
          widths={anchosPara(foto, [320, 480, 640, 800])}
          sizes="(min-width: 1024px) 340px, 72vw"
          style={j.fotos.foco ? `object-position: ${j.fotos.foco}` : undefined}
        />
      ) : (
        <div class="tarjeta__sin-foto" aria-hidden="true">
          {j.numero !== null && <span class="tarjeta__numero">{j.numero}</span>}
          <span class="tarjeta__iniciales">{iniciales(j.nombre)}</span>
        </div>
      )
    }
    {j.capitana && <span class="tarjeta__capitana dato">Capitana</span>}
  </div>
  <h3 class="tarjeta__nombre">{j.nombre}</h3>
  <p class="dato tarjeta__datos">{j.numero === null ? `# ${POR_CONFIRMAR.toLowerCase()}` : `#${j.numero}`} · {j.posicion ?? `Posición ${POR_CONFIRMAR.toLowerCase()}`}</p>
  <p class="tarjeta__club">{club ?? 'Club por confirmar'}</p>
</a>

<style>
  /* Un solo bloque de color con foto y datos: se lee como tarjeta aparte. */
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bloque);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 16%);
    color: var(--papel);
    text-decoration: none;
  }

  .tarjeta__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    container-type: inline-size;
  }

  .tarjeta__foto :global(.tarjeta__retrato) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* El apellido puede salirse del bloque: es un recurso gráfico, el nombre legible va abajo. */
  .tarjeta__apellido {
    --trazo: var(--papel);

    position: absolute;
    top: 6%;
    left: 4cqw;
    font-family: var(--fuente-display);
    font-size: 58cqw;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tarjeta__foto :global(.tarjeta__recorte) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    width: auto;
    max-width: 100%;
    height: 90%;
    margin-inline: auto;
    object-fit: contain;
    object-position: bottom;
  }

  .tarjeta__foto[data-orilla='derecha'] :global(.tarjeta__recorte) {
    margin-right: 0;
  }

  .tarjeta__marcador {
    position: absolute;
    right: 10px;
    bottom: 6px;
    color: var(--papel);
    font-family: var(--fuente-display);
    font-size: clamp(2.5rem, 18cqw, 4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    line-height: 1;
    text-align: right;
  }

  .tarjeta__sin-foto {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--papel);
    font-family: var(--fuente-display);
    font-weight: 900;
  }

  .tarjeta__numero {
    position: absolute;
    right: -0.04em;
    bottom: -0.12em;
    color: transparent;
    font-size: clamp(9rem, 15vw, 12rem);
    line-height: 1;
    -webkit-text-stroke: 2px var(--rojo);
  }

  .tarjeta__iniciales {
    position: relative;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .tarjeta__capitana {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 2px 10px;
    background: var(--papel);
    border-radius: 999px;
    color: var(--tinta);
  }

  .tarjeta__nombre {
    margin-top: 12px;
    padding-inline: 14px;
    font-family: var(--fuente-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .tarjeta:hover .tarjeta__nombre {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .tarjeta__datos {
    margin-top: 4px;
    padding-inline: 14px;
  }

  .tarjeta__club {
    margin-top: 2px;
    padding: 0 14px 14px;
    color: rgb(255 255 255 / 85%);
    font-size: 0.875rem;
    line-height: 1.35;
  }
</style>
