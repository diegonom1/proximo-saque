---
// El navegador la llena y la muestra (ver src/lib/cuenta.ts).
---

<div class="cuenta" role="timer" aria-label="Cuenta regresiva" data-cuenta>
  <p data-unidad="dias"><span>--</span> días</p>
  <p data-unidad="horas"><span>--</span> horas</p>
  <p data-unidad="minutos"><span>--</span> min</p>
  <p data-unidad="segundos"><span>--</span> seg</p>
</div>
<div class="envivo" role="status" data-envivo hidden>
  <p class="envivo__titulo"><span class="envivo__punto" aria-hidden="true"></span>En juego</p>
  <p class="envivo__desde" data-envivo-desde></p>
</div>
