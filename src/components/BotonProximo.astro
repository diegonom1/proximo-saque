---
import { partidos, paraCliente } from '../lib/datos';
import { vistaBoton } from '../lib/compromiso';
import { vigentes } from '../lib/tiempo';
import { ruta } from '../lib/presentacion';
import { ZONA_SITIO } from '../../scripts/lib/tiempo.mjs';

const ahora = Date.now();
const lista = vigentes(partidos, ahora).slice(0, 30).map(paraCliente);
const v = vistaBoton(lista, ahora, ZONA_SITIO);
---

<a id="boton-proximo" class="boton-proximo" href={ruta('agenda')} aria-label="Próximo partido" hidden={!v}>
  <span class="boton-proximo__cuando" data-boton="cuando">{v?.cuando}</span>
  <span class="boton-proximo__texto" data-boton="quien">{v?.quien}</span>
  <span class="boton-proximo__texto boton-proximo__equipos" data-boton="equipos">{v?.equipos}</span>
</a>
<script type="application/json" id="datos-boton" set:html={JSON.stringify(lista).replace(/</g, '\\u003c')} />

<script>
  import { vistaBoton } from '../lib/compromiso';

  const boton = document.getElementById('boton-proximo');
  const lista = JSON.parse(document.getElementById('datos-boton')?.textContent ?? '[]');

  function pintar() {
    if (!boton) return;
    const v = vistaBoton(lista, Date.now());
    boton.hidden = !v;
    if (!v) return;
    boton.setAttribute('aria-label', `Próximo partido, ${v.cuando}: ${v.quien}, ${v.equipos}`);
    for (const campo of ['cuando', 'quien', 'equipos'] as const) {
      const el = boton.querySelector(`[data-boton="${campo}"]`);
      if (el && el.textContent !== v[campo]) el.textContent = v[campo];
    }
  }

  pintar();
  setInterval(pintar, 30000);
</script>

<style>
  .boton-proximo {
    position: fixed;
    right: 16px;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px;
    align-items: center;
    max-width: calc(100vw - 32px);
    min-height: 52px;
    padding: 6px 20px 6px 16px;
    background: var(--rojo);
    border-radius: 999px;
    box-shadow: 0 6px 20px rgb(14 14 16 / 30%);
    color: var(--papel);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .boton-proximo__cuando {
    grid-row: span 2;
    font-family: var(--fuente-display);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .boton-proximo__texto {
    grid-column: 2;
    overflow: hidden;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .boton-proximo__equipos {
    font-size: 0.8125rem;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .boton-proximo {
      display: none;
    }
  }
</style>
