---
// La hora en su columna; a su lado el nombre y, abajo, los equipos. El navegador cambia [data-hora] por la hora del visitante.
import type { Partido } from '../lib/datos';
import { jugadorasDe } from '../lib/datos';
import { SELECCION, separador } from '../lib/partido';
import { ruta } from '../lib/presentacion';
import { hora, msDe } from '../lib/tiempo';
import { ZONA_SITIO } from '../../scripts/lib/tiempo.mjs';

interface Props {
  partido: Partido;
}

const { partido: p } = Astro.props;
const quienes = jugadorasDe(p);
const esSeleccion = p.tipo === 'seleccion';
---

<p class="linea">
  <span class:list={['linea__hora', { 'linea__hora--pendiente': !p.horaConfirmada }]} data-hora>{p.horaConfirmada ? hora(msDe(p), ZONA_SITIO) : 'Hora por confirmar'}</span>
  {esSeleccion && <strong>{SELECCION}</strong>}
  {
    !esSeleccion && quienes.length > 0 && (
      <strong>
        {quienes.map((j, i) => (
          <>
            {separador(i, quienes.length)}
            <a href={ruta(`jugadoras/${j.slug}`)}>{j.nombre}</a>
          </>
        ))}
      </strong>
    )
  }
  <span class="linea__equipos">
    <span class:list={{ nuestro: p.nuestro === 'local' }}>{p.local}</span> vs <span class:list={{ nuestro: p.nuestro === 'visita' }}>{p.visitante}</span>
  </span>
</p>

<style>
  .linea {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 14px;
    align-items: baseline;
    font-size: 1.125rem;
    line-height: 1.35;
  }

  .linea__hora {
    grid-row: span 2;
    font-family: var(--fuente-display);
    font-size: 1.625rem;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1;
  }

  .linea__hora--pendiente {
    max-width: 5.5em;
    font-family: var(--fuente-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  strong {
    grid-column: 2;
    font-weight: 700;
  }

  strong a {
    text-underline-offset: 3px;
  }

  .linea__equipos {
    grid-column: 2;
    color: var(--gris);
  }

  .nuestro {
    color: var(--fuerte);
    font-weight: 600;
  }
</style>
