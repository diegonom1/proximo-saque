---
import { getImage } from 'astro:assets';
import Cintillo from './Cintillo.astro';
import Cuenta from './Cuenta.astro';
import type { ImageMetadata } from 'astro';
import { partidos, paraCliente, seleccion } from '../lib/datos';
import { elegirCompromiso, vistaHero } from '../lib/compromiso';
import { anchosPara, fotosHero } from '../lib/fotos';
import { heroCompleto } from '../lib/tratamiento';
import { SELECCION, separador } from '../lib/partido';
import { ruta } from '../lib/presentacion';
import { vigentes } from '../lib/tiempo';
import { ZONA_SITIO } from '../../scripts/lib/tiempo.mjs';

const ahora = Date.now();
const lista = vigentes(partidos, ahora).slice(0, 30).map(paraCliente);
const torneo = seleccion.proximoTorneo;
const v = vistaHero(elegirCompromiso(lista, torneo, ahora, ZONA_SITIO), ahora, ZONA_SITIO);
const datosCliente = JSON.stringify({ lista, torneo }).replace(/</g, '\\u003c');

// <Picture> no admite un archivo distinto por pantalla: aquí hay uno vertical para celular.
const { escritorio, movil } = fotosHero();
const fuentes = async (foto: ImageMetadata, anchos: number[], media: string | undefined, sizes: string) => Promise.all(
  (['avif', 'webp'] as const).map(async (format) => {
    const imagen = await getImage({ src: foto, format, widths: anchosPara(foto, anchos) });
    return { media, sizes, type: `image/${format}`, srcset: imagen.srcSet.attribute };
  }),
);
// Con fotos chicas no hay pantalla completa: la horizontal va en un panel a su tamaño real, también
// en celular, porque ahí se ve nítida y sale todo el equipo.
const completo = Boolean(escritorio && movil && heroCompleto(escritorio, movil));
const sources = !escritorio || !movil
  ? []
  : completo
    ? [
      ...(await fuentes(movil, [640, 828, 1080], '(max-width: 767px)', '100vw')),
      ...(await fuentes(escritorio, [1280, 1920, 2400], '(min-width: 768px)', '100vw')),
    ]
    : await fuentes(escritorio, [640, 828, 1280], undefined, `(min-width: ${escritorio.width}px) ${escritorio.width}px, 100vw`);
const respaldo = escritorio ? await getImage({ src: escritorio, format: 'jpg', width: Math.min(1600, escritorio.width) }) : null;
---

<section class="hero" data-modo={v.modo} data-foto={completo ? 'completa' : 'panel'} data-base={ruta()} style={escritorio ? `--foto-ancho: ${escritorio.width}px` : undefined} aria-labelledby="hero-titulo">
  {
    respaldo ? (
      <picture class="hero__foto">
        {sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes={s.sizes} />)}
        <img src={respaldo.src} alt="Selección Mexicana femenil de voleibol" fetchpriority="high" decoding="async" />
      </picture>
    ) : (
      <div class="hero__sin-foto" aria-hidden="true">MÉXICO</div>
    )
  }
  <div class="marco hero__contenido">
    <p class="dato hero__etiqueta" data-h="etiqueta">{v.etiqueta}</p>
    <p class="hero__fecha" data-h="fecha" hidden={!v.fecha}>{v.fecha}</p>
    <h1 id="hero-titulo" class="hero__titulo" data-h="titulo">{v.titulo}</h1>
    <p class="hero__mientras" data-h="mientras" hidden={!v.mientras}>{v.mientras}</p>
    <p class="hero__linea" data-linea hidden={!v.linea}>
      {
        v.linea && (
          <>
            <span class="hero__linea-hora">{v.linea.hora}</span>
            {v.linea.seleccion && <span class="hero__linea-texto">{SELECCION}</span>}
            {
              !v.linea.seleccion && v.linea.jugadoras.length > 0 && (
                <span class="hero__linea-texto">
                  {v.linea.jugadoras.map((j, i) => (
                    <>
                      {separador(i, v.linea?.jugadoras.length ?? 0)}
                      <a href={ruta(`jugadoras/${j.slug}`)}>{j.nombre}</a>
                    </>
                  ))}
                </span>
              )
            }
            <span class="hero__linea-texto hero__linea-equipos">{v.linea.equipos}</span>
          </>
        )
      }
    </p>
    <p class="hero__detalle" data-h="detalle" hidden={!v.detalle}>{v.detalle}</p>
    <p class="dato hero__alla" data-h="alla" hidden={!v.alla}>{v.alla}</p>
    <Cuenta />
    <p class="hero__envivo dato" data-envivo hidden>En juego</p>
  </div>
  <Cintillo />
</section>

<script type="application/json" id="datos-hero" set:html={datosCliente} />

<script>
  import { elegirCompromiso, vistaHero, type LineaHero, type VistaHero } from '../lib/compromiso';
  import { SELECCION, separador } from '../lib/partido';
  import { escribirCompleta, escribirDias } from '../lib/cuenta';

  const hero = document.querySelector<HTMLElement>('.hero');
  const { lista, torneo } = JSON.parse(document.getElementById('datos-hero')?.textContent ?? '{"lista":[],"torneo":null}');
  const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');
  const envivo = document.querySelector<HTMLElement>('[data-envivo]');
  const linea = document.querySelector<HTMLElement>('[data-linea]');
  let lineaPintada = '';

  function escribirLinea(l: LineaHero | null) {
    if (!linea) return;
    linea.hidden = !l;
    const firma = JSON.stringify(l);
    if (!l || firma === lineaPintada) return;
    lineaPintada = firma;
    const pieza = (clase: string, ...contenido: (Node | string)[]) => {
      const el = document.createElement('span');
      el.className = clase;
      el.append(...contenido);
      return el;
    };
    const nodos = [pieza('hero__linea-hora', l.hora)];
    if (l.seleccion) {
      nodos.push(pieza('hero__linea-texto', SELECCION));
    } else if (l.jugadoras.length > 0) {
      nodos.push(pieza('hero__linea-texto', ...l.jugadoras.flatMap((j, i) => {
        const enlace = document.createElement('a');
        enlace.href = `${hero?.dataset.base ?? '/'}jugadoras/${j.slug}`;
        enlace.textContent = j.nombre;
        return [separador(i, l.jugadoras.length), enlace];
      })));
    }
    nodos.push(pieza('hero__linea-texto hero__linea-equipos', l.equipos));
    linea.replaceChildren(...nodos);
  }

  function escribir(campo: keyof VistaHero, valor: string | null) {
    const el = document.querySelector<HTMLElement>(`[data-h="${campo}"]`);
    if (!el) return;
    el.hidden = !valor;
    if (!valor || el.textContent === valor) return;
    el.textContent = valor;
    if (el.hasAttribute('aria-label')) el.setAttribute('aria-label', valor);
  }

  function pintar() {
    const ahora = Date.now();
    const v = vistaHero(elegirCompromiso(lista, torneo, ahora), ahora);
    if (hero) hero.dataset.modo = v.modo;
    for (const campo of ['etiqueta', 'fecha', 'titulo', 'mientras', 'detalle', 'alla'] as const) escribir(campo, v[campo]);
    escribirLinea(v.linea);

    const c = v.cuenta;
    if (envivo) envivo.hidden = c.modo !== 'envivo';
    if (cuenta) cuenta.hidden = c.modo !== 'completa' && c.modo !== 'dias';
    if (cuenta && c.modo === 'completa') escribirCompleta(cuenta, c.ms, ahora);
    if (cuenta && c.modo === 'dias') escribirDias(cuenta, c.dias);
  }

  // Con la intro, la cuenta espera a que se abra la cortina para rodar a la vista.
  const espera = document.documentElement.classList.contains('con-intro') ? 0.5 : 0;

  setTimeout(() => {
    pintar();
    setInterval(pintar, 1000);
  }, espera * 1000);

  // La fecha se arma dígito por dígito. Si el navegador la reescribe después, ya no se anima.
  Promise.all([import('../lib/movimiento'), import('gsap/SplitText')]).then(([{ conMovimiento, gsap }, { SplitText }]) => {
    gsap.registerPlugin(SplitText);
    conMovimiento(() => {
      const fecha = document.querySelector<HTMLElement>('.hero__fecha');
      if (!fecha || fecha.hidden) return;
      const { chars } = SplitText.create(fecha, { type: 'chars', mask: 'chars' });
      // SplitText esconde los dígitos y deja un aria-label, que en un párrafo no se lee: sin esto la
      // fecha quedaría muda para los lectores de pantalla.
      fecha.setAttribute('role', 'img');
      gsap.set(fecha, { opacity: 1 });
      gsap.fromTo(chars, { yPercent: 110 }, { yPercent: 0, stagger: 0.06, delay: espera });
      return () => fecha.removeAttribute('role');
    });
  });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--tinta);
    color: var(--papel);
  }

  .hero__foto,
  .hero__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero[data-foto='completa']:has(.hero__foto)::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 14 16 / 88%) 0%, rgb(14 14 16 / 45%) 50%, rgb(14 14 16 / 35%) 100%);
    content: '';
  }

  /* Foto chica: panel a su tamaño real que se funde con la tinta. */
  .hero[data-foto='panel']:has(.hero__foto) {
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }

  .hero[data-foto='panel'] .hero__foto {
    position: relative;
    inset: auto;
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    mask-image: linear-gradient(to top, transparent, #000 18%);
  }

  .hero[data-foto='panel']:has(.hero__foto) .hero__contenido {
    padding-block: 8px 76px;
  }

  .hero__sin-foto {
    position: absolute;
    top: 72px;
    left: 50%;
    color: transparent;
    font-family: var(--fuente-display);
    font-size: clamp(9rem, 44vw, 42rem);
    font-weight: 900;
    line-height: 0.85;
    transform: translateX(-50%);
    -webkit-text-stroke: 2px rgb(255 255 255 / 14%);
    white-space: nowrap;
  }

  .hero__contenido {
    position: relative;
    z-index: 1;
    padding-block: 96px 88px;
  }

  /* El motor la muestra cuando la parte en dígitos. */
  :global(.con-movimiento) .hero__fecha {
    opacity: 0;
  }

  .hero__etiqueta {
    margin-bottom: 12px;
    color: var(--papel);
  }

  .hero__etiqueta::before {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    background: var(--rojo);
    border-radius: 50%;
    content: '';
  }

  .hero__fecha {
    font-family: var(--fuente-display);
    font-size: clamp(4.5rem, 24vw, 17rem);
    font-variant-numeric: tabular-nums;
    font-weight: 900;
    line-height: 0.85;
  }

  .hero__titulo {
    max-width: 18ch;
    margin-top: 12px;
    font-family: var(--fuente-display);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero[data-modo='espera'] .hero__titulo {
    max-width: 12ch;
    margin-top: 0;
    font-size: clamp(3rem, 15vw, 10rem);
    font-weight: 900;
    line-height: 0.9;
  }

  .hero[data-modo='partido'] .hero__titulo {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .hero__mientras {
    margin-top: 20px;
    color: rgb(255 255 255 / 82%);
  }

  .hero__linea {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 14px;
    align-items: baseline;
    max-width: 40ch;
    margin-top: 4px;
    font-size: clamp(1.125rem, 3.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .hero[data-modo='partido'] .hero__linea {
    margin-top: 12px;
    font-family: var(--fuente-display);
    font-size: clamp(1.75rem, 7vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .hero__linea a {
    text-underline-offset: 3px;
  }

  /* El navegador también los crea, por eso van en global. */
  .hero__linea :global(.hero__linea-hora) {
    grid-row: span 2;
    font-variant-numeric: tabular-nums;
  }

  .hero__linea :global(.hero__linea-texto) {
    grid-column: 2;
  }

  .hero__linea :global(.hero__linea-equipos) {
    color: rgb(255 255 255 / 82%);
    font-weight: 400;
  }

  .hero[data-modo='partido'] .hero__linea :global(.hero__linea-equipos) {
    font-weight: 800;
  }

  .hero__detalle {
    margin-top: 8px;
    color: rgb(255 255 255 / 82%);
  }

  .hero__alla {
    margin-top: 6px;
    color: rgb(255 255 255 / 82%);
  }

  .hero__envivo {
    display: inline-block;
    margin-top: 20px;
    padding: 6px 12px;
    background: var(--rojo);
    border-radius: 999px;
  }

  @media (min-width: 768px) {
    .hero[data-foto='panel']:has(.hero__foto) {
      justify-content: flex-end;
      min-height: 100svh;
    }

    .hero[data-foto='panel'] .hero__foto {
      position: absolute;
      inset: 0 0 auto auto;
      width: min(var(--foto-ancho), 100%);
      aspect-ratio: 2.09;
      mask-image: linear-gradient(to top, transparent, #000 30%), linear-gradient(to right, transparent, #000 22%);
      mask-composite: intersect;
    }

    /* El techo del gimnasio sobra: se recorta por arriba para que el texto no tape al equipo. */
    .hero[data-foto='panel'] .hero__foto img {
      object-position: 50% 100%;
    }

    .hero[data-foto='panel']:has(.hero__foto) .hero__contenido {
      /* Lo que quede de alto después del texto: en una laptop el texto sube sobre la foto, que ahí ya se funde. */
      padding-block: min(calc(min(var(--foto-ancho), 100vw) / 2.09 * 0.84), calc(100svh - 432px)) 72px;
    }

    .hero[data-foto='panel'] .hero__fecha {
      font-size: clamp(6rem, 13vw, 11rem);
    }

    .hero[data-foto='panel'] .hero__titulo {
      max-width: none;
    }

    /* Sin torneo el título es largo: chico para que la cuenta quepa en la primera pantalla. */
    .hero[data-foto='panel'][data-modo='espera'] .hero__titulo {
      max-width: none;
      font-size: clamp(3rem, 6.5vw, 6rem);
    }

    /* La cuenta va junto a la fecha para que todo quepa en una laptop. */
    .hero[data-foto='panel']:has(.hero__foto) .hero__contenido {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 32px;
    }

    .hero[data-foto='panel'] .hero__contenido > * {
      grid-column: 1;
    }

    .hero[data-foto='panel'] .hero__contenido > :global([data-cuenta]),
    .hero[data-foto='panel'] .hero__contenido > .hero__envivo {
      grid-column: 2;
      grid-row: 1 / span 8;
      align-self: end;
    }
  }
</style>
