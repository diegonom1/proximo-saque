---
import { Font } from 'astro:assets';
import Encabezado from './Encabezado.astro';
import Pie from './Pie.astro';
import BotonProximo from './BotonProximo.astro';
import Intro from './Intro.astro';
import { ruta } from '../lib/presentacion';

interface Props {
  titulo?: string;
  descripcion?: string;
  intro?: boolean;
}

const {
  titulo = 'Próximo Saque',
  descripcion = 'Sigue a la Selección Mexicana femenil de voleibol y a cada seleccionada con su club: próximo partido, agenda y rankings.',
  intro = false,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX" data-intro={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0E10" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href={ruta('favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--fuente-display" preload />
    <Font cssVariable="--fuente-texto" preload={[{ weight: '400' }]} />
    <Font cssVariable="--fuente-mono" />
    <script is:inline>
      // Corre antes de pintar para que nada brinque. Lo que se esconde depende de estas clases: sin
      // JavaScript no existen, y si el motor de movimiento no carga, el seguro las quita.
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add('con-js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        raiz.classList.add('con-movimiento');
        setTimeout(function () {
          if (!window.movimientoListo) raiz.classList.remove('con-movimiento');
        }, 2500);
        // Al volver de un perfil, su foto regresa a su tarjeta. Tiene que quedar antes de pintar.
        addEventListener('pagereveal', function (evento) {
          var origen = window.navigation && navigation.activation && navigation.activation.from;
          var jugadora = origen && origen.url.match(/jugadoras\/([^/?#]+)/);
          var foto = jugadora && document.querySelector('[data-foto-vt="' + jugadora[1] + '"]');
          if (!evento.viewTransition || !foto) return;
          foto.style.viewTransitionName = 'foto-' + jugadora[1];
          function limpiar() {
            foto.style.viewTransitionName = '';
          }
          evento.viewTransition.finished.then(limpiar, limpiar);
        });
        if (!raiz.hasAttribute('data-intro')) return;
        try {
          if (sessionStorage.getItem('proximo-saque-intro')) return;
          sessionStorage.setItem('proximo-saque-intro', '1');
          raiz.classList.add('con-intro');
        } catch (e) {
          /* sin almacenamiento no se sabe si ya la vio: mejor no repetirla */
        }
      })();
    </script>
  </head>
  <body>
    {intro && <Intro />}
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Encabezado />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <BotonProximo />
  </body>
</html>

<script>
  // Va aparte de lo demás: si no carga, el sitio funciona igual, sin movimiento.
  import('../lib/movimiento').then(({ iniciar }) => iniciar());
</script>

<style is:global>
  :root {
    --papel: #ffffff;
    --hueso: #f4f3ef;
    --tinta: #0e0e10;
    --gris: #6b6b70;
    --linea: #e4e2dc;
    --rojo: #d1202f;
    --verde: #1f7a4d;
    --gutter: clamp(16px, 4vw, 48px);
    --curva: cubic-bezier(0.16, 1, 0.3, 1); /* la misma en src/lib/movimiento.ts y marcador.ts */
    --duracion: 0.7s;
    color-scheme: light;
  }

  /* Bloques de las jugadoras: siempre oscuros, para que el apellido blanco se lea. */
  [data-color] {
    --bloque: var(--rojo);
  }

  [data-color='negro'] {
    --bloque: #08080a;
  }

  [data-color='verde'] {
    --bloque: #0f4a37;
  }

  [data-color='carbon'] {
    --bloque: #303237;
  }

  @view-transition {
    navigation: auto;
  }

  ::view-transition-group(*),
  ::view-transition-old(*),
  ::view-transition-new(*) {
    animation-duration: var(--duracion);
    animation-timing-function: var(--curva);
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--fuente-texto);
    font-size: 1rem;
    line-height: 1.5;
    overflow-x: clip;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
    list-style: none;
  }

  [hidden] {
    display: none !important;
  }

  :focus-visible {
    outline: 3px solid var(--rojo);
    outline-offset: 2px;
  }

  .marco {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .seccion {
    padding-block: clamp(56px, 9vw, 112px);
    scroll-margin-top: 16px;
  }

  .seccion--hueso {
    background: var(--hueso);
  }

  .seccion__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .titulo-seccion {
    font-family: var(--fuente-display);
    font-size: clamp(3.25rem, 13vw, 9rem);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
  }

  /* Recurso 1: lo que se revela sale de atrás de su propio borde. */
  .mascara {
    display: block;
    overflow: hidden;
    margin-block: -0.2em;
    padding-block: 0.2em; /* para que no se coma los acentos */
  }

  /* Recurso 2: contorno debajo, relleno encima. Sin JavaScript la capa ya está en su lugar. */
  .relleno {
    --trazo: var(--tinta);

    position: relative;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--trazo);
  }

  .relleno__capa {
    position: absolute;
    inset: -0.25em 0;
    overflow: hidden;
    padding-block: 0.25em;
    color: var(--trazo);
    -webkit-text-stroke: 0;
  }

  .relleno__interior {
    display: block;
  }

  /* Recurso 3: cada dígito rueda dentro de su celda. */
  .digito {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .digito > span {
    display: block;
  }

  .digito__saliente {
    position: absolute;
    inset: 0;
  }

  .dato {
    font-family: var(--fuente-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .enlace {
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .etiqueta {
    padding: 2px 10px;
    background: var(--rojo);
    border-radius: 999px;
    color: var(--papel);
    font-family: var(--fuente-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .etiqueta--juego {
    background: var(--tinta);
  }

  .boton {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 20px;
    background: var(--rojo);
    border-radius: 999px;
    color: var(--papel);
    font-weight: 600;
    text-decoration: none;
  }

  .boton--chico {
    min-height: 44px;
    padding-inline: 16px;
    font-size: 0.9375rem;
  }

  /* Ocupa su lugar desde el principio para que nada brinque al llenarse. Sin JavaScript no sale. */
  .cuenta {
    display: none;
    gap: clamp(16px, 4vw, 36px);
    margin-top: 20px;
    font-family: var(--fuente-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .con-js .cuenta {
    display: flex;
  }

  .cuenta p > span {
    display: block;
    font-family: var(--fuente-display);
    font-size: clamp(2.5rem, 10vw, 4.5rem);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
  }

  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .saltar {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 30;
    padding: 8px 16px;
    background: var(--papel);
    color: var(--tinta);
  }

  .saltar:focus {
    top: 8px;
  }
</style>
